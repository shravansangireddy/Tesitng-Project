# SERVER ONLY: configure in Supabase Edge Function secrets, never frontend/VITE.
# Keep disabled until the operator privacy review and sandbox acceptance are complete.
PAYMENTS_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_REST_APP_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_REST_APP_SECRET
PAYPAL_WEBHOOK_ID=YOUR_SANDBOX_WEBHOOK_ID
APP_BASE_URL=http://127.0.0.1:5173/
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the deployed Edge runtime.
