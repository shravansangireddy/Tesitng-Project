VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Default: local guest learning only. These flags are NOT proof of compliance or consent.
# Complete the operator/school review and real consent/authorization workflow first.
VITE_CHILD_PRIVACY_REVIEWED=false
VITE_PRIVACY_NOTICE_URL=
VITE_PRIVACY_CONTACT=
VITE_DATA_RETENTION_NOTICE=
# Browser providers may process voice/text remotely. Separate operator decision:
VITE_BROWSER_SPEECH_ENABLED=false

# Enable only after deploying the server payment functions and testing sandbox.
# PayPal client secret, webhook ID, and service-role key belong ONLY in server secrets.
VITE_PAYPAL_CHECKOUT_ENABLED=false
